@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Native ambient and event-driven menu effects. No disk I/O in a frame.
+ * Included by gfxmenu/view.c. Opt in with set erdtree_motion=1.
+ */
+#include <grub/env.h>
+
+static int
+erdtree_enabled (void)
+{
+  const char *value = grub_env_get ("erdtree_motion");
+  return value && !grub_strcmp (value, "1");
+}
+
+#include "erdtree_ambient.h"
+
+void
+grub_gfxmenu_motion_idle (void *data)
+{
+  grub_gfxmenu_view_t view = data;
+  struct grub_erdtree_ambient *motion = view->ambient;
+  grub_video_rect_t region = view->screen;
+  grub_uint64_t now, elapsed;
+  grub_err_t saved_errno = grub_errno;
+  int scene_due, selection_due;
+  if (!erdtree_enabled ()) return;
+  now = grub_get_time_ms ();
+  scene_due = erdtree_ambient_enabled () && motion && now - motion->last >= motion->frame_ms;
+  selection_due = view->motion_active && now - view->motion_last >= 25;
+  if (!scene_due && !selection_due) return;
+  if (selection_due)
+    {
+      view->motion_last = now;
+      if (now - view->motion_changed >= 360) view->motion_active = 0;
+    }
+  if (scene_due)
+    {
+      motion->last = now;
+      erdtree_ambient_render (view, now);
+      if (!selection_due)
+        {
+          if (motion->variant == 4)
+            {
+              int w = view->screen.width, h = view->screen.height;
+              region.x += w * 27 / 100;
+              region.y += h * 205 / 1000;
+              region.width = w * 73 / 100 - w * 27 / 100;
+              region.height = h * 67 / 100 - h * 205 / 1000;
+            }
+          else
+            {
+              region.x += view->screen.width / 2;
+              region.width -= view->screen.width / 2;
+            }
+        }
+      grub_video_set_area_status (GRUB_VIDEO_AREA_ENABLED);
+      grub_gfxmenu_view_redraw (view, &region);
+      grub_video_swap_buffers ();
+      if (view->double_repaint) grub_gfxmenu_view_redraw (view, &region);
+      elapsed = grub_get_time_ms () - now;
+      if (elapsed > motion->frame_ms)
+        motion->frame_ms = elapsed > 990 ? 1000 : (unsigned) elapsed + 10;
+    }
+  else
+    grub_gfxmenu_redraw_menu (view);
+  grub_errno = saved_errno;
+}
+
+void
+grub_gfxmenu_motion_confirm (void *data)
+{
+  grub_gfxmenu_view_t view = data;
+  struct grub_video_bitmap *fade = 0;
+  grub_menu_entry_t entry;
+  grub_uint64_t start, age;
+  grub_err_t saved_errno = grub_errno;
+  int w = view->screen.width, h = view->screen.height, duration, last_alpha = -1;
+
+  if (!erdtree_enabled () || w < 320 || h < 200 || w > 2560 || h > 1600)
+    return;
+  entry = grub_menu_get_entry (view->menu, view->selected);
+  if (!entry)
+    return;
+  /* A submenu gets the acknowledgement flash without the full boot fade. */
+  duration = entry->submenu ? 170 : 850;
+  if (!entry->submenu &&
+      grub_video_bitmap_create (&fade, w, h, GRUB_VIDEO_BLIT_FORMAT_RGBA_8888))
+    {
+      grub_errno = saved_errno;
+      return;
+    }
+  if (fade)
+    grub_memset (fade->data, 0, fade->mode_info.pitch * h);
+  view->motion_confirming = 1;
+  view->motion_active = 0;
+  start = grub_get_time_ms ();
+
+  do
+    {
+      int alpha, pass;
+      age = grub_get_time_ms () - start;
+      if (age > (unsigned) duration) age = duration;
+      alpha = age > 170 ? (int) (age - 170) * 255 / (duration - 170) : 0;
+      /* Smoothstep fade: no abrupt cut at either end. */
+      alpha = alpha * alpha * (765 - 2 * alpha) / 65025;
+      if (fade && alpha != last_alpha)
+        {
+          int x, y;
+          for (y = 0; y < h; ++y)
+            for (x = 0; x < w; ++x)
+              ((grub_uint8_t *) fade->data)[y * fade->mode_info.pitch + x * 4 + 3] = alpha;
+          last_alpha = alpha;
+        }
+      for (pass = 0; pass < (view->double_repaint ? 2 : 1); ++pass)
+        {
+          grub_video_set_viewport (0, 0, w, h);
+          grub_video_set_area_status (GRUB_VIDEO_AREA_DISABLED);
+          grub_gfxmenu_view_redraw (view, &view->screen);
+          if (fade && alpha)
+            grub_video_blit_bitmap (fade, GRUB_VIDEO_BLIT_BLEND, 0, 0, 0, 0, w, h);
+          if (pass == 0) grub_video_swap_buffers ();
+        }
+      if (age < (unsigned) duration) grub_millisleep (20);
+    }
+  while (age < (unsigned) duration);
+
+  grub_video_bitmap_destroy (fade);
+  view->motion_confirming = 0;
+  grub_errno = saved_errno;
+}
--- /dev/null
+++ b/grub-core/gfxmenu/erdtree_highlight.h
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Selection artwork computed only during a brief user-triggered transition.
+ * Included in gui_list.c after list_impl_t.
+ */
+#include <grub/env.h>
+#include <grub/time.h>
+
+/* Keep entry names and actions intact; only the Ring's presentation changes. */
+static void
+erdtree_draw_title (const char *title, grub_font_t font,
+                    grub_video_color_t color, int width, int baseline)
+{
+  const char *variant = grub_env_get ("erdtree_variant");
+  int left = 0;
+  char capitals[512];
+  if (variant && !grub_strcmp (variant, "ring"))
+    {
+      grub_size_t i, length = grub_strlen (title);
+      if (length < sizeof (capitals))
+        {
+          for (i = 0; i <= length; ++i)
+            capitals[i] = title[i] >= 'a' && title[i] <= 'z'
+              ? title[i] - 'a' + 'A' : title[i];
+          title = capitals;
+        }
+      left = (width - grub_font_get_string_width (font, title)) / 2;
+      if (left < 0) left = 0;
+      /* A discreet shadow keeps the fine lettering readable over the knight. */
+      grub_font_draw_string (title, font, grub_video_map_rgb (4, 8, 5),
+                             left + 1, baseline + 1);
+    }
+  grub_font_draw_string (title, font, color, left, baseline);
+}
+
+static int
+erdtree_draw_highlight (list_impl_t self, int top, int width, int height)
+{
+  struct grub_video_bitmap *bitmap;
+  const char *enabled = grub_env_get ("erdtree_motion");
+  const char *variant = grub_env_get ("erdtree_variant");
+  grub_err_t saved_errno = grub_errno;
+  grub_uint64_t age;
+  int x, y, pulse = 0, center = -1000, radius;
+  int color[3] = {200, 163, 94}, tint = 0;
+  int ring = variant && !grub_strcmp (variant, "ring");
+
+  if (variant && !grub_strcmp (variant, "carian"))
+    { color[0] = 130; color[1] = 184; color[2] = 238; tint = 1; }
+  else if (variant && !grub_strcmp (variant, "destined"))
+    { color[0] = 203; color[1] = 75; color[2] = 85; tint = 1; }
+  else if (variant && !grub_strcmp (variant, "farum"))
+    { color[0] = 200; color[1] = 184; color[2] = 150; tint = 1; }
+
+  if (!enabled || grub_strcmp (enabled, "1") || width < 64 ||
+      width > 4096 || height < 12 || height > 200)
+    return 0;
+  bitmap = self->motion_highlight;
+  if (bitmap && ((int) bitmap->mode_info.width != width ||
+                 (int) bitmap->mode_info.height != height))
+    {
+      grub_video_bitmap_destroy (bitmap);
+      self->motion_highlight = bitmap = 0;
+    }
+  if (!bitmap)
+    {
+      if (grub_video_bitmap_create (&bitmap, width, height,
+                                   GRUB_VIDEO_BLIT_FORMAT_RGBA_8888))
+        {
+          grub_errno = saved_errno;
+          return 0;
+        }
+      self->motion_highlight = bitmap;
+    }
+  age = grub_get_time_ms () - self->view->motion_changed;
+  radius = width / 5;
+  if (self->view->motion_active && age < 360)
+    {
+      pulse = (360 - (int) age) * 85 / 360;
+      center = -radius + (int) age * (width + 2 * radius) / 360;
+    }
+  if (self->view->motion_confirming)
+    pulse = 125;
+
+  for (y = 0; y < height; ++y)
+    for (x = 0; x < width; ++x)
+      {
+        grub_uint8_t *p = (grub_uint8_t *) bitmap->data +
+          y * bitmap->mode_info.pitch + x * 4;
+        int distance = x > center ? x - center : center - x;
+        int sweep = distance < radius ? (radius - distance) * 70 / radius : 0;
+        int vertical = height / 2 - grub_abs (y - height / 2);
+        if (ring)
+          {
+            int horizontal = (width - grub_abs (2 * x - width + 1)) * 256 / width;
+            int soft_y = (height - grub_abs (2 * y - height + 1)) * 256 / height;
+            int opacity = 135 + pulse / 2 + sweep / 3;
+            horizontal = horizontal * horizontal / 256;
+            soft_y = soft_y * soft_y / 256 * soft_y / 256;
+            p[0] = 218; p[1] = 181; p[2] = 95;
+            p[3] = opacity * horizontal / 256 * soft_y / 256;
+            continue;
+          }
+        int a = 13 + (width - x) * 36 / width;
+        int edge = x >= 8 && x < width - 8 && (y == 1 || y == height - 2);
+        int diamond = (grub_abs (x - 8) + grub_abs (y - height / 2) == 6 ||
+                       grub_abs (x - (width - 9)) + grub_abs (y - height / 2) == 6);
+        a += (pulse + sweep) * (height / 2 + vertical) / height;
+        if (edge) a = 108 + pulse + sweep;
+        if (diamond) a = 195 + pulse / 3;
+        if (x < 8 || x >= width - 8) a = diamond ? a : 0;
+        if (a > 255) a = 255;
+        p[0] = 200 + (pulse + sweep) / 7;
+        p[1] = 163 + (pulse + sweep) / 5;
+        p[2] = 94 + (pulse + sweep) / 4;
+        if (tint)
+          {
+            int c;
+            for (c = 0; c < 3; ++c)
+              p[c] = color[c] + (255 - color[c]) * (pulse + sweep) / 320;
+          }
+        p[3] = a;
+      }
+  grub_video_blit_bitmap (bitmap, GRUB_VIDEO_BLIT_BLEND,
+                          0, top, 0, 0, width, height);
+  grub_errno = saved_errno;
+  return 1;
+}
--- /dev/null
+++ b/grub-core/gfxmenu/erdtree_ambient.h
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * A swaying Site of Grace and circling light, rendered entirely in GRUB.
+ * One reusable bitmap; no allocations, disk reads or floating point per frame.
+ */
+#include <grub/trig.h>
+
+struct grub_erdtree_ambient
+{
+  struct grub_video_bitmap *frame;
+  grub_uint64_t epoch, last;
+  unsigned frame_ms;
+  int variant;
+  grub_uint8_t *sigil_halo;
+  int halo_width, halo_height;
+  grub_uint16_t flame_mask[2560];
+};
+
+static void erdtree_ring_init (grub_gfxmenu_view_t view);
+
+static int
+erdtree_ambient_enabled (void)
+{
+  const char *value = grub_env_get ("erdtree_ambient");
+  return erdtree_enabled () && (!value || grub_strcmp (value, "0"));
+}
+
+static void
+erdtree_ambient_destroy (grub_gfxmenu_view_t view)
+{
+  if (!view->ambient) return;
+  grub_video_bitmap_destroy (view->ambient->frame);
+  grub_free (view->ambient->sigil_halo);
+  grub_free (view->ambient);
+  view->ambient = 0;
+}
+
+static void
+erdtree_ambient_init (grub_gfxmenu_view_t view)
+{
+  struct grub_video_bitmap *source = view->scaled_desktop_image;
+  struct grub_erdtree_ambient *motion;
+  const char *variant = grub_env_get ("erdtree_variant");
+  grub_err_t saved_errno = grub_errno;
+  int x, y, w = view->screen.width, h = view->screen.height;
+  if (!erdtree_ambient_enabled () || view->ambient || view->ambient_attempted)
+    return;
+  view->ambient_attempted = 1;
+  if (!source || w < 320 || h < 200 || w > 2560 || h > 1600 ||
+      source->mode_info.width != (unsigned) w ||
+      source->mode_info.height != (unsigned) h ||
+      (source->mode_info.blit_format != GRUB_VIDEO_BLIT_FORMAT_RGB_888 &&
+       source->mode_info.blit_format != GRUB_VIDEO_BLIT_FORMAT_RGBA_8888))
+    return;
+  motion = grub_zalloc (sizeof (*motion));
+  if (!motion) goto failed;
+  view->ambient = motion;
+  if (variant && !grub_strcmp (variant, "carian")) motion->variant = 1;
+  else if (variant && !grub_strcmp (variant, "destined")) motion->variant = 2;
+  else if (variant && !grub_strcmp (variant, "farum")) motion->variant = 3;
+  else if (variant && !grub_strcmp (variant, "ring")) motion->variant = 4;
+  if (grub_video_bitmap_create (&motion->frame, w, h, source->mode_info.blit_format))
+    goto failed;
+  for (y = 0; y < h; ++y)
+    grub_memcpy ((grub_uint8_t *) motion->frame->data + y * motion->frame->mode_info.pitch,
+                 (grub_uint8_t *) source->data + y * source->mode_info.pitch,
+                 w * source->mode_info.bytes_per_pixel);
+  motion->epoch = motion->last = grub_get_time_ms ();
+  motion->frame_ms = 50;
+  for (x = 0; x < w; ++x)
+    {
+      int distance = grub_abs (x - w * 745 / 1000);
+      int mask = 256 - (distance - w * 6 / 100) * 256 / (w * 12 / 100);
+      if (mask < 0) mask = 0;
+      if (mask > 256) mask = 256;
+      motion->flame_mask[x] = mask * mask / 256 * (768 - 2 * mask) / 256;
+    }
+  if (motion->variant == 4) erdtree_ring_init (view);
+  return;
+failed:
+  erdtree_ambient_destroy (view);
+  grub_errno = saved_errno;
+}
+
+static struct grub_video_bitmap *
+erdtree_background (grub_gfxmenu_view_t view)
+{
+  if (erdtree_ambient_enabled () && view->ambient) return view->ambient->frame;
+  return view->scaled_desktop_image;
+}
+
+static void
+erdtree_tinted_spark (struct grub_video_bitmap *frame, int cx, int cy, int radius,
+                       int alpha, int red, int green, int blue)
+{
+  int dx, dy, c, w = frame->mode_info.width, h = frame->mode_info.height;
+  int bpp = frame->mode_info.bytes_per_pixel;
+  for (dy = -radius; dy <= radius; ++dy)
+    for (dx = -radius; dx <= radius; ++dx)
+      {
+        int distance = dx * dx + dy * dy;
+        int strength;
+        grub_uint8_t *p;
+        if (distance >= radius * radius || cx + dx < w / 2 || cx + dx >= w ||
+            cy + dy < 0 || cy + dy >= h) continue;
+        strength = alpha * (radius * radius - distance) / (radius * radius);
+        strength = strength * strength / 255;
+        p = (grub_uint8_t *) frame->data + (cy + dy) * frame->mode_info.pitch +
+          (cx + dx) * bpp;
+        for (c = 0; c < 3; ++c)
+          {
+            int value = p[c] + strength * (c == 0 ? red : c == 1 ? green : blue) / 255;
+            p[c] = value > 255 ? 255 : value;
+          }
+      }
+}
+
+static void
+erdtree_spark (struct grub_video_bitmap *frame, int cx, int cy, int radius, int alpha)
+{
+  erdtree_tinted_spark (frame, cx, cy, radius, alpha, 255, 209, 123);
+}
+
+/* Interpolate the integer sine table so a slow wave has no visible steps. */
+static int
+erdtree_wave (unsigned t, unsigned period, unsigned offset)
+{
+  unsigned phase = (t % period) * 65536U / period + offset * 256U;
+  int fraction = phase & 255;
+  return (grub_sin (phase >> 8) * (256 - fraction) +
+          grub_sin ((phase >> 8) + 1) * fraction) / 256;
+}
+
+#include "erdtree_ring.h"
+#include "erdtree_scenes.h"
+
+static void
+erdtree_ambient_render (grub_gfxmenu_view_t view, grub_uint64_t now)
+{
+  struct grub_erdtree_ambient *motion = view->ambient;
+  struct grub_video_bitmap *source = view->scaled_desktop_image;
+  struct grub_video_bitmap *frame = motion->frame;
+  int w = view->screen.width, h = view->screen.height;
+  int bpp = source->mode_info.bytes_per_pixel, x0 = w / 2;
+  unsigned t = (unsigned) (now - motion->epoch);
+  int root = h * 645 / 1000;
+  int sway = erdtree_wave (t, 5600, 0) * (w * 26 / 1000) / 64;
+  int breath = 7 + erdtree_wave (t, 3800, 0) * 5 / 16384;
+  int reaction = 0, x, y, i;
+  if (motion->variant == 4)
+    {
+      erdtree_ring_render (view, now);
+      return;
+    }
+  if (motion->variant)
+    {
+      erdtree_scene_render (view, now);
+      return;
+    }
+  if (view->motion_active && now - view->motion_changed < 360)
+    reaction = (360 - (int) (now - view->motion_changed)) * 12 / 360;
+
+  /* Inverse-sample the immutable artwork. The root and mound never move;
+     the upper flame bends farther, with a smaller wave travelling upward. */
+  for (y = 0; y < h; ++y)
+    {
+      int bend = y < root ? (root - y) * 256 / (h / 2) : 0;
+      int ripple = erdtree_wave (t, 2700, y * 140 / h) * (w * 5 / 1000) / 64;
+      int offset;
+      const grub_uint8_t *row = (const grub_uint8_t *) source->data + y * source->mode_info.pitch;
+      grub_uint8_t *d = (grub_uint8_t *) frame->data +
+        y * frame->mode_info.pitch + x0 * bpp;
+      if (bend > 256) bend = 256;
+      if (y < h / 12) bend = bend * y / (h / 12);
+      offset = (sway + ripple) * bend / 256;
+      if (!bend)
+        {
+          grub_memcpy (d, row + x0 * bpp, (w - x0) * bpp);
+          continue;
+        }
+      for (x = x0; x < w; ++x, d += bpp)
+        {
+          int sx = x * 256 - offset * motion->flame_mask[x] / 256;
+          int fraction, c, glow;
+          const grub_uint8_t *p, *next;
+          if (sx < x0 * 256) sx = x0 * 256;
+          if (sx > (w - 1) * 256) sx = (w - 1) * 256;
+          fraction = sx & 255;
+          p = row + (sx >> 8) * bpp;
+          next = (sx >> 8) < w - 1 ? p + bpp : p;
+          glow = (p[0] > p[2] ? p[0] - p[2] : 0) *
+            (breath + reaction) / 128 * motion->flame_mask[x] / 256 * bend / 256;
+          for (c = 0; c < 3; ++c)
+            {
+              int value = (p[c] * (256 - fraction) + next[c] * fraction) / 256;
+              value += glow * (c == 0 ? 5 : c == 1 ? 4 : 2) / 5;
+              d[c] = value > 255 ? 255 : value;
+            }
+          if (bpp == 4) d[3] = p[3];
+        }
+    }
+
+  /* Soft moving accents follow the existing elliptical grace ring. */
+  for (i = 0; i < 3; ++i)
+    {
+      int trail, radius = w * 3 / 1920;
+      if (radius < 2) radius = 2;
+      for (trail = 0; trail < 28; ++trail)
+        {
+          unsigned angle = i * 85 + trail;
+          int px = w * 743 / 1000 + erdtree_wave (t, 11000, angle + 64) * (w * 211 / 1000) / 16384;
+          int py = h * 760 / 1000 + erdtree_wave (t, 11000, angle) * (h * 143 / 1000) / 16384;
+          int alpha = 30 + trail * 3;
+          erdtree_spark (frame, px, py, radius, alpha);
+        }
+    }
+
+  /* A few motes rise beside the flame, fading before they wrap. */
+  for (i = 0; i < 18; ++i)
+    {
+      unsigned seed = (unsigned) (i + 1) * 2654435761U;
+      unsigned life = 8000 + seed % 7000;
+      unsigned age = (t + seed % life) % life;
+      int fade = age < life / 2 ? age : life - age;
+      int alpha = fade < 1400 ? fade * 130 / 1400 : 130;
+      int px = w * (650 + (seed >> 12) % 200) / 1000 +
+        erdtree_wave (t, 5700 + i * 200, i * 29) * (w / 90) / 16384;
+      int py = h * 60 / 100 - (int) (age * (h / 2) / life);
+      int radius = (2 + i % 2) * w / 1920;
+      if (radius < 2) radius = 2;
+      erdtree_spark (frame, px, py, radius, alpha);
+    }
+}
